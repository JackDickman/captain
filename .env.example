# Captain backend — environment variables.
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` itself is git-ignored and must never be committed.

# OpenAI API key — used for chat responses, rendering (gpt-image-2),
# extraction, palette, profile rewriter. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Firecrawl API key — used during first-session for property-data scraping.
# https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# Optional model overrides (all default to gpt-5.4-mini / gpt-5.4-nano).
# CAPTAIN_CHAT_MODEL=gpt-5.4-mini
# CAPTAIN_UPDATE_MODEL=gpt-5.4-mini
# CAPTAIN_EXTRACTION_MODEL=gpt-5.4-mini
# CAPTAIN_CALENDAR_MODEL=gpt-5.4-nano
# CAPTAIN_PALETTE_MODEL=gpt-5.4-nano
# CAPTAIN_RENDER_MODEL=gpt-image-2

# Dev-only: when set to "1", /first-session and /chat short-circuit to
# canned responses (no API spend). Used during iOS UI iteration.
# CAPTAIN_DEV_FIXTURE=1
