# Secrets — must NEVER be committed.
.env

# macOS clutter
.DS_Store

# Claude Code session/state data (per-machine, not source)
.claude/

# Python
__pycache__/
*.pyc
.venv/

# Dev fixtures with real photos of the actual home (avoid leaking PII)
prototype-photos/
prototype-output/
first-session-input/
first-session-output/

# User data — markdown profiles + history snapshots + sqlite db + chat photos
backend/profiles/
backend/captain.db
backend/captain.db-*
backend/rendered/
backend/chat-photos/
backend/hunt-photos/
backend/hunt-documents/
backend/cache/

# iOS — Xcode project is regenerated from project.yml via xcodegen
ios/Captain.xcodeproj/
ios/build/
# Bundled debug photo of the actual home — local-only, contains GPS EXIF.
# To re-enable the --auto-submit debug flow, drop any JPEG named TestHome.jpg
# into this folder on your local machine.
ios/Captain/DebugAssets/
